# ============ 大模型 API 配置(复制本文件为 .env 后填写)============
# 演示模式开关:true = 不调用大模型,使用内置示例结果(离线可用)
DEMO_MODE=true

# 供应商: zhipu(智谱GLM) / dashscope(通义千问) / deepseek / openai(通用兼容)
LLM_PROVIDER=zhipu
# 默认模型(可按供应商覆盖)
LLM_MODEL=glm-4.5-air

# ---- 智谱 GLM: https://open.bigmodel.cn ----
ZHIPU_API_KEY=

# ---- 通义千问: https://dashscope.aliyuncs.com ----
DASHSCOPE_API_KEY=

# ---- DeepSeek: https://platform.deepseek.com ----
DEEPSEEK_API_KEY=

# ---- 其他 OpenAI 兼容端点(可选,LLM_PROVIDER=openai 时生效)----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ---- 可选:联网补充行业参考(②页"🌐 可选"开关的默认数据源地址)----
# 指向一个返回行业基准 JSON 的地址(格式见 core/external.py);留空=默认不联网,纯离线可用
EXTERNAL_REF_URL=
