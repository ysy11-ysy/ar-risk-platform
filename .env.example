# ============ 大模型 API 配置(复制本文件为 .env 后填写)============
DEMO_MODE=true
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4.5-air

# ---- 智谱 GLM: https://open.bigmodel.cn ----
ZHIPU_API_KEY=

# ---- 通义千问: https://dashscope.aliyuncs.com ----
DASHSCOPE_API_KEY=

# ---- DeepSeek: https://platform.deepseek.com ----
DEEPSEEK_API_KEY=

# ---- 其他 OpenAI 兼容端点(可选)----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
