   "signal_id": "R001-S01",
   "signal_name": "收入现金流背离",
   "name": "净现比",
   "unit": "倍",
   "formula": "y0.cfo_net / y0.net_profit",
   "rules": [
    {
     "level": "高风险",
     "cond": "y0.cfo_net <= 0 or (y0.cfo_net < 0.5*y0.net_profit and y1.cfo_net < 0.5*y1.net_profit)"
    },
    {
     "level": "关注",
     "cond": "v < 1"
    }
   ],
   "basis": "规则:高风险=净现比连续2年<0.5或任意一年为负;关注=0.5~1;正常>1"
  },
